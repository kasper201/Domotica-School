/dts-v1/;
/plugin/;

/ {
    fragment@0 {
        target-path = "/";
        __overlay__ {
            leds {
                compatible = "gpio-leds";
                led_0: led_0 {
                    gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
                    label = "Green LED";
                };
            };
        };
    };
};
